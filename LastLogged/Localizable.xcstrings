    "auth.error.appleCredentials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to get Apple ID credentials."
          }
        }
      }
    },
    "auth.error.attemptsRemaining %@ %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%#@arg2@)"
          },
          "substitutions": {
            "arg2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "1 attempt remaining"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld attempts remaining"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "auth.error.cooldownLong %lld": {
      "extractionState": "manual",
      "localizations": {
