<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode rewrites this to "production" for App Store/TestFlight archives.
	     Required for registerForRemoteNotifications() to return a token. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<!-- Only the apex domain serves /.well-known/apple-app-site-association
		     (generated by website/src/pages/.well-known/). Adding a host here
		     that does not serve one just fails association silently. -->
		<string>applinks:lastlogged.com</string>
		<string>webcredentials:lastlogged.com</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pearsonmedia.lastlogged</string>
	</array>
</dict>
</plist>
