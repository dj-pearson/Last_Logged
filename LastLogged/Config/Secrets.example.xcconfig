// Copy this file to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored; do NOT commit it.
//
// Note on '//' — xcconfig treats '//' as a comment even inside values.
// If your Supabase URL contains '//', split it via $()/ substitution:
//   SUPABASE_URL = https:$()//your-project.supabase.co
//
// The build settings these feed into are declared in Info.plist and read
// by AppSecrets.swift at runtime via Bundle.main.object(forInfoDictionaryKey:).

SUPABASE_URL = https:$()//YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY
REVENUECAT_API_KEY = YOUR_REVENUECAT_API_KEY
TELEMETRYDECK_APP_ID = YOUR_TELEMETRYDECK_APP_ID

// Optional — crash reporting. Leave as the placeholder to disable Sentry
// entirely; AppSecrets.validate() does not require it.
SENTRY_DSN = YOUR_SENTRY_DSN
