---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Terms of Service — Last Logged';
const description =
  'Terms of service for Last Logged. Review the terms that govern your use of our app and services.';
---

<BaseLayout title={title} description={description}>
  <!-- Header -->
  <header class="header">
    <div class="container">
      <a href="/" class="logo">Last Logged</a>
      <nav>
        <a href="/#features">Features</a>
        <a href="/#pricing">Pricing</a>
      </nav>
    </div>
  </header>

  <!-- Content -->
  <main class="legal">
    <div class="container">
      <h1>Terms of Service</h1>
      <p class="last-updated">Last updated: March 24, 2026</p>

      <h2>Acceptance of Terms</h2>
      <p>
        By downloading, installing, or using the Last Logged application (&ldquo;the App&rdquo;)
        or visiting lastlogged.com (&ldquo;the Website&rdquo;), you agree to be bound by these
        Terms of Service (&ldquo;Terms&rdquo;). If you do not agree to these Terms, do not use the
        App or Website.
      </p>
      <p>
        These Terms constitute a legal agreement between you and Pearson Media LLC
        (&ldquo;we,&rdquo; &ldquo;us,&rdquo; or &ldquo;our&rdquo;). We reserve the right to update
        these Terms at any time. Continued use of the App after changes constitutes acceptance of the
        revised Terms.
      </p>

      <h2>Subscription Terms</h2>
      <h3>Free Tier</h3>
      <p>
        Last Logged offers a free tier that includes up to 5 trackers, basic widget support, and the
        last 10 completion history entries per item. The free tier is fully functional and does not
        require an account or payment.
      </p>
      <h3>Premium Subscriptions</h3>
      <p>
        Premium features &mdash; including unlimited trackers, full completion history, all widget
        styles, cloud sync, and data export &mdash; are available through the following paid plans:
      </p>
      <ul>
        <li><strong>Monthly:</strong> $3.99 per month with a 7-day free trial</li>
        <li><strong>Annual:</strong> $24.99 per year with a 7-day free trial</li>
        <li><strong>Lifetime:</strong> $59.99 one-time purchase</li>
      </ul>
      <h3>Billing and Renewal</h3>
      <p>
        Subscriptions are billed through your Apple ID account via the App Store. Monthly and annual
        subscriptions automatically renew unless cancelled at least 24 hours before the end of the
        current billing period. You can manage or cancel your subscription at any time through your
        Apple ID settings.
      </p>
      <h3>Free Trials</h3>
      <p>
        Monthly and annual plans include a 7-day free trial. If you do not cancel before the trial
        ends, you will be charged for the first billing period. Free trial eligibility is determined
        by Apple and is typically limited to one trial per Apple ID.
      </p>
      <h3>Refunds</h3>
      <p>
        All purchases are processed by Apple. Refund requests must be submitted through Apple&rsquo;s
        standard refund process. We do not have the ability to issue refunds directly.
      </p>

      <h2>User Responsibilities</h2>
      <p>When using Last Logged, you agree to:</p>
      <ul>
        <li>Use the App only for its intended purpose of tracking personal recurring events</li>
        <li>Provide accurate information when creating an account (if applicable)</li>
        <li>Keep your account credentials secure and confidential</li>
        <li>Not attempt to reverse-engineer, decompile, or disassemble the App</li>
        <li>Not use the App for any unlawful or unauthorized purpose</li>
        <li>Not interfere with or disrupt the App&rsquo;s servers or infrastructure</li>
        <li>Not attempt to access other users&rsquo; data or accounts</li>
      </ul>
      <p>
        You are solely responsible for the data you store in the App. We recommend regularly backing
        up important data using the export feature.
      </p>

      <h2>Intellectual Property</h2>
      <p>
        The App, Website, and all related content &mdash; including but not limited to the design,
        code, graphics, and text &mdash; are the property of Pearson Media LLC and are protected by
        copyright and intellectual property laws. You may not copy, modify, distribute, or create
        derivative works based on our intellectual property without prior written consent.
      </p>

      <h2>Limitation of Liability</h2>
      <p>
        To the maximum extent permitted by applicable law, Pearson Media LLC and its affiliates,
        officers, directors, and employees shall not be liable for any indirect, incidental, special,
        consequential, or punitive damages arising out of or related to your use of the App or
        Website.
      </p>
      <p>
        The App is provided &ldquo;as is&rdquo; and &ldquo;as available&rdquo; without warranties of
        any kind, whether express or implied. We do not warrant that the App will be uninterrupted,
        error-free, or free of harmful components.
      </p>
      <p>
        In no event shall our total liability exceed the amount you have paid us in the twelve (12)
        months preceding the claim, or $50.00, whichever is greater.
      </p>

      <h2>Termination</h2>
      <p>
        We reserve the right to suspend or terminate your access to the App at any time for violation
        of these Terms. Upon termination, your right to use the App ceases immediately. You may
        export your data before termination using the App&rsquo;s data export feature.
      </p>

      <h2>Governing Law</h2>
      <p>
        These Terms shall be governed by and construed in accordance with the laws of the United
        States, without regard to conflict of law principles. Any disputes arising under these Terms
        shall be resolved in the courts of competent jurisdiction.
      </p>

      <h2>Contact Us</h2>
      <p>
        If you have any questions about these Terms, please contact us at:
      </p>
      <p>
        <strong>Pearson Media LLC</strong><br />
        Email: <a href="mailto:support@lastlogged.com">support@lastlogged.com</a>
      </p>
    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span class="logo">Last Logged</span>
        <p>&copy; {new Date().getFullYear()} Pearson Media LLC</p>
      </div>
      <nav class="footer-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="mailto:support@lastlogged.com">Contact</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Header */
  .header {
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
  }

  .header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .logo:hover {
    text-decoration: none;
  }

  .header nav {
    display: flex;
    gap: 1.5rem;
  }

  .header nav a {
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .header nav a:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  /* Container */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Legal Content */
  .legal {
    padding: 4rem 0;
  }

  .legal h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .last-updated {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 2.5rem;
  }

  .legal h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .legal h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .legal p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1rem;
    max-width: 720px;
  }

  .legal ul {
    margin: 0.5rem 0 1.5rem 1.5rem;
    max-width: 720px;
  }

  .legal li {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    padding: 0.2rem 0;
  }

  /* Footer */
  .footer {
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .legal h1 {
      font-size: 2rem;
    }

    .footer-inner {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .legal {
      padding: 2.5rem 0;
    }

    .legal h1 {
      font-size: 1.75rem;
    }
  }
</style>
