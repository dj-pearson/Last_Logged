<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (android:fullBackupContent).

  The Room database holds the user's full tracker history and
  EncryptedSharedPreferences holds auth/subscription state. Neither belongs in
  Google's cloud backup: the AndroidKeyStore master key that decrypts the prefs
  is hardware-bound and is NOT backed up, so a restored copy would be
  undecryptable anyway — and the tracker history is already synced through
  Supabase for signed-in users.
-->
<full-backup-content>
    <exclude domain="database" path="lastlogged.db" />
    <exclude domain="database" path="lastlogged.db-shm" />
    <exclude domain="database" path="lastlogged.db-wal" />
    <exclude domain="sharedpref" path="lastlogged_secure_prefs.xml" />
    <exclude domain="file" path="datastore/" />
    <!-- Data exports are user-initiated, transient, and can contain everything. -->
    <exclude domain="external" path="." />
</full-backup-content>
