<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (android:dataExtractionRules). Covers both cloud backup and
  device-to-device transfer. Same reasoning as backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="lastlogged.db" />
        <exclude domain="database" path="lastlogged.db-shm" />
        <exclude domain="database" path="lastlogged.db-wal" />
        <exclude domain="sharedpref" path="lastlogged_secure_prefs.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="lastlogged.db" />
        <exclude domain="database" path="lastlogged.db-shm" />
        <exclude domain="database" path="lastlogged.db-wal" />
        <exclude domain="sharedpref" path="lastlogged_secure_prefs.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
