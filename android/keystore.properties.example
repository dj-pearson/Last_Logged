# Release keystore configuration
#
# To create a release keystore:
#   keytool -genkey -v -keystore lastlogged-release.jks \
#       -keyalg RSA -keysize 2048 -validity 10000 -alias lastlogged
#
# Then copy this file to android/keystore.properties, fill in values, and
# place the .jks file inside android/app/ (or give an absolute path).
# keystore.properties and *.jks are gitignored.

storeFile=app/lastlogged-release.jks
storePassword=CHANGE_ME
keyAlias=lastlogged
keyPassword=CHANGE_ME
