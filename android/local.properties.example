# Copy this to local.properties and fill in your values
# DO NOT commit local.properties to version control

sdk.dir=/path/to/android/sdk

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# RevenueCat Configuration
REVENUECAT_API_KEY=your-revenuecat-android-api-key

# TelemetryDeck Configuration (optional)
TELEMETRYDECK_APP_ID=your-telemetrydeck-app-id

# Google Sign-In — use the Web OAuth client ID from Google Cloud Console
# (NOT the Android client ID). Also used server-side by Supabase for token
# validation. Leave empty to hide the "Continue with Google" button.
GOOGLE_WEB_CLIENT_ID=your-google-web-oauth-client-id.apps.googleusercontent.com

# Sentry crash reporting (optional). Leave empty to disable entirely.
SENTRY_DSN=
