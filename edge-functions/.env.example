# Supabase Configuration
# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co
# Service role key (NOT the anon key) - has full access to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# APNs Configuration (Apple Push Notification service)
# Option 1 (preferred): Base64-encoded .p8 key content for env-based injection
# Generate with: base64 -i AuthKey.p8
# APNS_KEY_CONTENT=BASE64_ENCODED_P8_KEY
# Option 2 (fallback): Path to the .p8 auth key file from Apple Developer portal
APNS_KEY_PATH=./certs/AuthKey.p8
# Key ID from Apple Developer portal (10-character string)
APNS_KEY_ID=YOUR_KEY_ID
# Team ID from Apple Developer portal (10-character string)
APNS_TEAM_ID=YOUR_TEAM_ID
# App bundle identifier
APNS_BUNDLE_ID=com.pearsonmedia.lastlogged
# Set to "true" for production APNs, "false" for sandbox
APNS_PRODUCTION=false

# RevenueCat Webhook
# Webhook authorization secret from RevenueCat dashboard (Settings > Webhooks)
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret

# Cron / Admin Authentication
# Secret token required to manually trigger /send-reminder-digest
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Server Configuration
PORT=3000

# FCM Configuration (Firebase Cloud Messaging — Android push)
# Without these, Android devices are skipped by the reminder digest.
# All three come from a Firebase service-account JSON:
# Firebase Console > Project Settings > Service accounts > Generate new private key
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# The "private_key" field. Newlines may be left \n-escaped.
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
